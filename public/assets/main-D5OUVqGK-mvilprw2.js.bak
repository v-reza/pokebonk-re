`,add:20}]},"venom-sting":{name:c(`Aguijón Venenoso`),desc:c(`+10% velocidad de ataque. Tus críticos envenenan y los envenenados reciben +20% de daño. Evoluciona pronto (Kakuna al Nv. 8, Beedrill al Nv. 36); como Kakuna, +30 armadura.`),mods:[{stat:`attackSpeed`,mul:1.1}]},tailwind:{name:c(`Viento Afín`),desc:c(`+12% velocidad, +20% velocidad de proyectiles y +1 salto. Como buen Volador, planeas manteniendo Saltar.`),mods:[{stat:`moveSpeed`,mul:1.12},{stat:`projSpeed`,mul:1.2},{stat:`extraJumps`,add:1}]},"serpent-glare":{name:c(`Mirada Serpiente`),desc:c(`+1 regeneración (Mudar). Cada 4 s tu mirada paraliza a los enemigos que tienes delante (7 m).`),mods:[{stat:`regen`,add:1}],tick:(e,t)=>{if(e.time%4>=1)return;let n=t.facing.x,r=t.facing.y,i=t.pos.x,a=t.pos.z;e.vfx.add.spawn({x:i+n*1.2,y:t.pos.y+1.4,z:a+r*1.2,life:.4,size:.6,endSize:1.8,color:16765498,shape:F.Eye,glow:.3});for(let t of e.enemies.within(i+n*3.5,a+r*3.5,4.5)){let o=e.enemies.x[t]-i,s=e.enemies.z[t]-a,c=Math.hypot(o,s)||1;(o*n+s*r)/c>.45&&c<7&&e.combat.applyStatus(t,`paralysis`,1)}}},"sand-rush":{name:c(`Ímpetu Arena`),desc:c(`+10 armadura y +6% crítico. Con tormenta de arena, +30% velocidad.`),mods:[{stat:`armor`,add:10},{stat:`critChance`,add:.06}]},"lunar-blessing":{name:c(`Bendición Lunar`),desc:c(`+20 suerte y +1 regeneración. Tu Ultimate se carga un 30% más rápido y al lanzarla recuperas un 15% de PS.`),mods:[{stat:`luck`,add:20},{stat:`regen`,add:1}]},chlorophyll:{name:c(`Clorofila`),desc:c(`+10% velocidad y +1 regeneración. Con sol, +30% velocidad y +20% de daño. Cada 6 s sueltas una nube de polen (4,5 m) que envenena.`),mods:[{stat:`moveSpeed`,mul:1.1},{stat:`regen`,add:1}],tick:(e,t)=>{if(e.time%6>=1)return;let n=t.pos.x,r=t.pos.y,i=t.pos.z;for(let t=0;t<14;t++){let a=P.range(0,Math.PI*2),o=P.range(2,6);e.vfx.norm.spawn({x:n,y:r+.8,z:i,vx:Math.cos(a)*o,vy:P.range(.3,1.2),vz:Math.sin(a)*o,drag:2.2,life:.9,size:.3,endSize:.55,color:t%2?13144319:12118122,shape:F.PixSpore,spin:2})}Og(e,t,4.5,115