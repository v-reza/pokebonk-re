{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        "host": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
        },
        "open": {
          ".read": "auth != null",
          ".write": "auth != null && (data.parent().child('host').val() === auth.uid || newData.parent().child('host').val() === auth.uid)"
        },
        "at": {
          ".write": "auth != null && (data.parent().child('host').val() === auth.uid || newData.parent().child('host').val() === auth.uid)"
        },
        "m": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || data.parent().parent().child('host').val() === auth.uid)"
          }
        },
        "q": {
          "$to": {
            ".read": "auth != null",
            ".write": "auth != null && (auth.uid === $to || data.parent().parent().child('host').val() === auth.uid)",
            "$msg": {
              ".write": "auth != null && (auth.uid === $to || !root.child('rooms').child($room).child('m').exists() || root.child('rooms').child($room).child('m').child(auth.uid).exists() || root.child('rooms').child($room).child('host').val() === auth.uid)",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 200000)"
            }
          }
        }
      }
    },
    "runs": {
      "$run": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
